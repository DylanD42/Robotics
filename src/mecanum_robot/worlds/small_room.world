<?xml version="1.0"?>
<sdf version="1.6">
  <world name="small_room">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ============ Walls ============ -->
    <!-- Room interior approx 12m x 12.5m -> ~150 sq ft equivalent scaled to a
         convenient sim size; adjust wall length/position to taste as long as
         the enclosed area is in the right ballpark. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 0.1 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- ============ Obstacles ============ -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>1.5 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder">
      <static>true</static>
      <pose>-1.5 -1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.1 0.8 1</ambient>
            <diffuse>0.6 0.1 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_sphere">
      <static>true</static>
      <pose>2.5 -2.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>.67</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>.67</radius></sphere></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
